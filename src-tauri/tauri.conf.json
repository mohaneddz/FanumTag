{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fanumtag",
  "version": "0.1.0",
  "identifier": "com.fanumtag.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FanumTag",
        "width": 1280,
        "height": 860,
        "minHeight": 760,
        "minWidth": 1024,
        "transparent": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "publisher": "FanumTag",
    "shortDescription": "A fast, local video/image naming utility.",
    "resources": [
      "lib/llama-server.exe",
      "lib/llama.dll",
      "lib/mtmd.dll",
      "lib/ggml.dll",
      "lib/ggml-base.dll",
      "lib/ggml-cpu.dll",
      "lib/ggml-cuda.dll",
      "lib/cudart64_12.dll",
      "lib/cublas64_12.dll",
      "lib/cublasLt64_12.dll",
      "lib/whisper-bin-x64.zip",
      "weights/Qwen2-VL-2B-Instruct-IQ2_M.gguf",
      "weights/mmproj-Qwen2-VL-2B-Instruct-f16.gguf"
    ],
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
