{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "fanumtag",
  "version": "1.2.0",
  "identifier": "com.fanumtag.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1430",
    "beforeBuildCommand": "pnpm build",
    "beforeBundleCommand": "node scripts/stage-model-bundle.mjs",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "FanumTag",
        "width": 1280,
        "height": 860,
        "minHeight": 760,
        "minWidth": 1024,
        "transparent": true,
        "resizable": true,
        "decorations": false,
        "fullscreen": false,
        "maximizable": true
      }
    ],
    "security": {
      "csp": null,
      "assetProtocol": {
        "enable": true
      }
    }
  },
  "bundle": {
    "active": true,
    "targets": "nsis",
    "publisher": "FanumTag",
    "shortDescription": "A fast, local video/image naming utility.",
    "resources": [
      "lib/llama-server.exe",
      "lib/llama.dll",
      "lib/mtmd.dll",
      "lib/ggml.dll",
      "lib/ggml-base.dll",
      "lib/ggml-cpu-*.dll",
      "lib/ggml-cuda.dll",
      "lib/ggml-rpc.dll",
      "lib/libomp.dll",
      "lib/llama-common.dll",
      "lib/llama-server-impl.dll",
      "lib/cudart64_12.dll",
      "lib/cublas64_12.dll",
      "lib/cublasLt64_12.dll",
      "lib/whisper-bin-x64.zip"
    ],
    "windows": {
      "nsis": {
        "installerHooks": "windows/model-sidecars.nsh"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "fs": {
      "requireLiteralLeadingDot": false
    }
  }
}
